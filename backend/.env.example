# Provider primário: Groq (Llama 3.3 70B, gratis, ultra-rapido)
# Pegue key em https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL_ID=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL_ID=openai/gpt-oss-120b

# Provider fallback: Google Gemini (usado se Groq falhar/quota)
# Pegue key em https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-key-here
MODEL_ID=gemini-flash-latest
FALLBACK_MODEL_ID=gemini-flash-lite-latest

# Retry/backoff
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.5

# Cache retention (dias)
CACHE_RETENTION_DAYS=7

# Logs: text | json
LOG_FORMAT=text

# Prod
# FRONTEND_URL=https://bi-agent-rosy.vercel.app
# FRONTEND_URL_REGEX=^https://.*\.vercel\.app$
